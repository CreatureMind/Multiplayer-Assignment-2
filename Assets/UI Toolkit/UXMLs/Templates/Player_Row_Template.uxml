<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/LobbyStyle.uss?fileID=7433441132597879392&amp;guid=c1ae93633323eed4e9baa1825210ea51&amp;type=3#LobbyStyle"/>
    <ui:VisualElement style="flex-grow: 1; flex-direction: row; margin-bottom: 5px;">
        <ui:VisualElement name="container" style="flex-grow: 1; background-color: rgb(128, 128, 128); flex-direction: row; align-items: center; align-content: auto; justify-content: space-between;">
            <ui:VisualElement style="flex-grow: 0; flex-direction: row; justify-content: flex-start; width: 50%; height: 100%;">
                <ui:Label text="Player name" name="player-name" class="Lable" style="padding-left: 4px; padding-right: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; align-content: auto;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="sessionName" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
                <ui:Label text="is Ready!/Not ready" name="ready-status" class="Lable" style="padding-left: 4px; padding-right: 4px; margin-top: 4px; margin-right: 4px; margin-bottom: 4px; margin-left: 4px; align-content: auto; align-items: flex-start;">
                    <Bindings>
                        <ui:DataBinding property="value" data-source-path="sessionName" binding-mode="ToTarget"/>
                    </Bindings>
                </ui:Label>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:Button text="Kick" name="kick-button" style="-unity-text-align: middle-center; justify-content: flex-start; align-items: auto; align-self: auto; align-content: auto; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 5px; font-size: 32px;"/>
    </ui:VisualElement>
</ui:UXML>
