                    </ui:VisualElement>
                    <ui:VisualElement name="Text_Row_Template" class="chat-msg" style="flex-direction: row; flex-wrap: wrap;">
                        <ui:Label text="@From CreatureMind:" class="chat-msg__prefix chat-msg__prefix--whisper-from"/>
