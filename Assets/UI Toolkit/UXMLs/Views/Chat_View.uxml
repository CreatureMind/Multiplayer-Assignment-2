<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/LobbyStyle.uss?fileID=7433441132597879392&amp;guid=c1ae93633323eed4e9baa1825210ea51&amp;type=3#LobbyStyle"/>
    <ui:VisualElement name="VisualElement" picking-mode="Ignore" style="flex-grow: 1; margin-bottom: 4px;">
        <ui:Button text="Chat" name="chat-btn" style="left: 0; bottom: 0; position: absolute; margin-bottom: 4px; margin-top: 4px; font-size: 32px;"/>
        <ui:VisualElement name="chat-container" enabled="true" style="flex-grow: 1; justify-content: flex-end; border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-left-color: rgb(128, 128, 128); border-right-color: rgb(128, 128, 128); border-top-color: rgb(128, 128, 128); border-bottom-color: rgb(128, 128, 128); position: absolute; bottom: 65px; left: 0; margin-left: 4px; margin-bottom: 0; height: 30%; width: 30%;">
            <ui:VisualElement name="log-container" style="flex-direction: column-reverse; flex-grow: 1; height: auto;">
                <ui:ScrollView horizontal-scroller-visibility="Hidden" vertical-scroller-visibility="Hidden" name="chat-scroll-view" mouse-wheel-scroll-size="5" style="flex-grow: 1; margin-left: 4px; margin-right: 4px; padding-left: 4px; background-color: rgba(0, 0, 0, 0.5); margin-top: 4px; padding-bottom: 4px; border-left-color: rgb(128, 128, 128); border-right-color: rgb(128, 128, 128); border-top-color: rgb(128, 128, 128); border-bottom-color: rgb(128, 128, 128); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px;">
                    <ui:VisualElement name="Text_Row_Template" class="chat-msg" style="flex-direction: row; flex-wrap: wrap; margin-top: -7px;">
                        <ui:Label text="@To CreatureMind:" class="chat-msg__prefix chat-msg__prefix--whisper-to"/>
