                    </ui:VisualElement>
                    <ui:VisualElement name="Text_Row_Template" class="chat-msg" style="flex-direction: row; flex-wrap: wrap; margin-top: -7px;">
                        <ui:Label text="#CreatureMind:" class="chat-msg__prefix chat-msg__prefix--all"/>
