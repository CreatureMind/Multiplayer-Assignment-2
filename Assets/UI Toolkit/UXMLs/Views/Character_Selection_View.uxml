<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/Styles/LobbyStyle.uss?fileID=7433441132597879392&amp;guid=c1ae93633323eed4e9baa1825210ea51&amp;type=3#LobbyStyle"/>
    <ui:VisualElement name="container" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.75); justify-content: center; align-items: stretch; padding-top: 40px; padding-bottom: 40px; padding-left: 80px; padding-right: 80px;">
        <ui:Label text="Choose Your Character" name="header" enable-rich-text="true" emoji-fallback-support="true" parse-escape-sequences="false" selectable="false" focusable="false" double-click-selects-word="true" triple-click-selects-line="true" class="header" style="margin-bottom: 4px; font-size: 54px;"/>
        <ui:VisualElement name="character-grid" style="flex-direction: row; flex-wrap: wrap; justify-content: center; align-items: flex-start;"/>
        <ui:Label text="" name="status-label" class="Lable" style="color: rgb(255, 255, 100); font-size: 28px; -unity-text-align: middle-center; margin-top: 20px;"/>
    </ui:VisualElement>
